{
  "name": "@saavedra/identity",
  "version": "0.1.0",
  "description": "The Saavedra family identity for every Saavedra app: colour tokens (light and dark), typography, logos, a Tailwind preset and a React logo component.",
  "license": "SEE LICENSE IN README.md",
  "private": false,
  "main": "tailwind-preset.js",
  "exports": {
    ".": "./tailwind-preset.js",
    "./tailwind-preset": "./tailwind-preset.js",
    "./tokens.css": "./tokens.css",
    "./tokens.json": "./tokens.json",
    "./react": "./react/index.js",
    "./logo/*": "./logo/*"
  },
  "types": "react/index.d.ts",
  "files": [
    "tailwind-preset.js",
    "tokens.css",
    "tokens.json",
    "react/",
    "logo/",
    "fonts/",
    "docs/",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "test": "node scripts/contrast.mjs",
    "check": "node scripts/contrast.mjs"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": { "optional": true }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/jevillegasd/saavedra-identity.git"
  },
  "engines": { "node": ">=18" }
}
